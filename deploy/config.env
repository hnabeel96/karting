# Read by the deploy workflow. Not secret: the server address, user and SSH key are
# GitHub secrets (DEPLOY_HOST, DEPLOY_USER, DEPLOY_KEY).
#
# DOMAIN: the address players open. Leave empty to serve on http://<droplet-ip>:3000.
DOMAIN=kart.pineapp.win
#
# PORT: the local port the game server listens on behind nginx. Must not clash with
# other apps on the droplet (3000 is taken there).
PORT=3471
